{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"exactOptionalPropertyTypes": false,
		"isolatedModules": true,
		"skipLibCheck": true,
		"types": ["vitest/globals"]
	},
	"include": ["src", "tests"]
}
